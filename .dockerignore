!Dockerfile
!pyproject.toml
!uv.lock
!backend/
!backend/app/
!backend/app/**
!frontend/
!frontend/package*.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
frontend/src/**/*.test.ts
**/__pycache__
**/*.pyc
