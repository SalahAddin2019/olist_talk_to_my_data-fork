# Copy to .env. The backend reads it; the browser never sees these values.
# Foundry project endpoint (Foundry portal > project overview).
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=olist-agent
# Optional: pin an agent version. Leave unset to use the latest version.
FOUNDRY_AGENT_VERSION=
FOUNDRY_TIMEOUT_S=60
# Foundry agents use Microsoft Entra ID, not API keys. Locally, run `az login`.
# In a container without Azure CLI, use a service principal or managed identity, e.g.:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
